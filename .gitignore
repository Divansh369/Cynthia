# === .gitignore for Cynthia Chatbot MLOps Demo ===

# 1. PYTHON AND DEPENDENCIES (BACKEND)
# ====================================
# Virtual Environment
venv/
.venv/
env/
*.pyc
__pycache__/

# Python build artifacts
dist/
build/
*.egg-info/

# Dependencies installed by pip
/backend/requirements.txt  # If generated during a build step (keep if manually managed)

# Testing and Coverage
.pytest_cache/
.coverage

# Jupyter/IPython Notebook artifacts
.ipynb_checkpoints
*.iml

# 2. MACHINE LEARNING ARTIFACTS (GENERATED DATA)
# ==============================================
# The 'artifacts' directory contains generated model files and pickle dumps.
# These should generally NOT be tracked by Git, as they are large and rebuilt
# by train.py. They should be managed by DVC or excluded.
/artifacts/
!/artifacts/.gitkeep # Optional: keep this file if you want the folder structure

# Keras/TensorFlow saved models
*.h5
*.keras
saved_model/

# Pickle files (Vocabulary and Classes)
*.pkl

# 3. NEXT.JS / REACT (FRONTEND)
# ==============================
# Next.js build and cache directories
.next/
out/
node_modules/
npm-debug.log*
yarn-error.log*
yarn-debug.log*

# Next.js static files cache
.vercel/

# 4. ENVIRONMENT & SENSITIVE FILES
# =================================
# Local environment variables
.env
.env.local

# FastAPI/Gunicorn runtime files
*.pid
*.log
